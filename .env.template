# ============================================
# Cat99Sky Medusa Backend — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# For Railway: set these as environment variables in your Railway service settings.

# === Database (Required) ===
# Local dev:      postgresql://postgres:postgres@localhost:5432/medusa_db
# Railway:        Use the DATABASE_URL from your Railway PostgreSQL service
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medusa_db

# === Redis (Optional for dev, Required for production) ===
# Railway:        Use the REDIS_URL from your Railway Redis service
# Leave empty for local dev (falls back to in-memory)
REDIS_URL=
CACHE_REDIS_URL=
LOCKING_REDIS_URL=

# === CORS (Required) ===
# Comma-separated origins. Update with your actual storefront URL for production.
STORE_CORS=http://localhost:8000,http://localhost:3000,https://*.vercel.app
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:8000,http://localhost:3000,https://*.vercel.app

# === Secrets (Required) ===
# IMPORTANT: Generate random secrets for production!
JWT_SECRET=supersecret-jwt-change-in-production
COOKIE_SECRET=supersecret-cookie-change-in-production

# === Worker Mode (Production only) ===
# "shared" (default) = server + worker in one process (fine for small scale)
# "server" = API server only
# "worker" = background worker only
MEDUSA_WORKER_MODE=shared

# === Admin Dashboard ===
# Set to "true" to disable admin (e.g. on worker instance)
DISABLE_MEDUSA_ADMIN=false
# Set to your deployed URL so Admin UI can reach the API
MEDUSA_BACKEND_URL=

# === Port (Railway sets this automatically) ===
PORT=9000
